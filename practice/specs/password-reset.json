{
  "name": "Password reset (practice 1)",
  "description": "A user who forgot their password asks for a reset. The service creates a one-time token, stores a hash of it, and emails a link through an email provider. The user clicks the link and sets a new password.",
  "assumptions": "Email is a separate, less trusted channel. Reset tokens are single use and expire.",
  "externalDependencies": "Email provider",
  "zones": [
    {
      "name": "Our systems",
      "type": "SE.TB.B.TMCore.CorpNet"
    }
  ],
  "elements": [
    {
      "name": "User",
      "type": "SE.EI.TMCore.User"
    },
    {
      "name": "Reset page",
      "type": "SE.P.TMCore.WebApp",
      "zone": "Our systems"
    },
    {
      "name": "Account service",
      "type": "SE.P.TMCore.WebSvc",
      "zone": "Our systems"
    },
    {
      "name": "Accounts DB",
      "type": "SE.DS.TMCore.SQL",
      "zone": "Our systems",
      "custom": {
        "dataClass": "credentials, tokens"
      }
    },
    {
      "name": "Email provider",
      "type": "SE.EI.TMCore.WebSvc"
    }
  ],
  "flows": [
    {
      "from": "User",
      "to": "Reset page",
      "name": "Reset request with email address",
      "type": "SE.DF.TMCore.HTTPS"
    },
    {
      "from": "Reset page",
      "to": "Account service",
      "name": "Create reset token",
      "type": "SE.DF.TMCore.HTTPS"
    },
    {
      "from": "Account service",
      "to": "Accounts DB",
      "name": "Store token hash",
      "type": "GE.DF"
    },
    {
      "from": "Account service",
      "to": "Email provider",
      "name": "Reset email with link",
      "type": "SE.DF.TMCore.HTTPS"
    },
    {
      "from": "User",
      "to": "Reset page",
      "name": "Link click and new password",
      "type": "SE.DF.TMCore.HTTPS"
    },
    {
      "from": "Reset page",
      "to": "Account service",
      "name": "Token and new password",
      "type": "SE.DF.TMCore.HTTPS"
    },
    {
      "from": "Account service",
      "to": "Accounts DB",
      "name": "Update password hash",
      "type": "GE.DF"
    }
  ]
}
