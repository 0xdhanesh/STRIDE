{
  "name": "Billing service",
  "description": "Customers view and pay invoices in a React SPA. An nginx gateway terminates TLS and proxies to a FastAPI service that stores invoices in Postgres, charges cards through Stripe and queues receipt jobs in Redis for a worker that emails receipts via SendGrid. Users authenticate with Auth0.",
  "assumptions": "Derived from docker-compose.yml and source code. The backend network is internal-only (docker-compose.yml:31). Auth0, Stripe and SendGrid are trusted third parties outside our control.",
  "externalDependencies": "Auth0 (identity), Stripe (payments), SendGrid (email)",
  "zones": [
    { "name": "Customer device", "type": "SE.TB.B.TMCore.Sandbox", "evidence": ["web/src/api.ts:1"] },
    { "name": "Edge", "type": "SE.TB.B.TMCore.CorpNet", "evidence": ["docker-compose.yml:3", "docker-compose.yml:7"] },
    { "name": "Backend network", "type": "SE.TB.B.TMCore.CorpNet", "evidence": ["docker-compose.yml:31"] }
  ],
  "elements": [
    { "name": "Customer", "type": "SE.EI.TMCore.User" },
    { "name": "Billing SPA", "type": "SE.P.TMCore.BrowserClient", "zone": "Customer device",
      "custom": { "framework": "React", "rendersHtmlFromData": "invoice.memo" },
      "evidence": ["web/src/api.ts:1", "web/src/InvoiceView.tsx:3"] },
    { "name": "Gateway", "type": "SE.P.TMCore.WebServer", "zone": "Edge",
      "custom": { "software": "nginx 1.27", "terminatesTls": "yes" },
      "evidence": ["docker-compose.yml:3", "docker-compose.yml:5"] },
    { "name": "Billing API", "type": "SE.P.TMCore.WebSvc", "zone": "Backend network",
      "props": { "implementsAuthenticationScheme": "Yes", "implementsCustomAuthorizationMechanism": "Yes", "acceptsInputFrom": "Any Remote User or Entity" },
      "custom": { "framework": "FastAPI" },
      "evidence": ["api/app.py:8", "api/auth.py:6", "api/auth.py:12"] },
    { "name": "Receipt worker", "type": "SE.P.TMCore.Win32Service", "zone": "Backend network",
      "evidence": ["worker/receipts.py:5"] },
    { "name": "Invoices DB", "type": "SE.DS.TMCore.SQL", "zone": "Backend network",
      "custom": { "engine": "PostgreSQL 16", "dataClass": "PII, financial" },
      "evidence": ["docker-compose.yml:23", "api/db.py:2"] },
    { "name": "Audit log", "type": "GE.DS", "zone": "Backend network",
      "props": { "storesLogData": "Yes" },
      "custom": { "storage": "audit_log table in Invoices DB" },
      "evidence": ["api/audit.py:3"] },
    { "name": "Job queue", "type": "SE.DS.TMCore.Cache", "zone": "Backend network",
      "custom": { "engine": "Redis 7 list jobs:receipts" },
      "evidence": ["docker-compose.yml:26", "api/app.py:23"] },
    { "name": "Auth0", "type": "SE.EI.TMCore.AuthProvider", "evidence": ["api/auth.py:4", "web/src/api.ts:2"] },
    { "name": "Stripe", "type": "SE.EI.TMCore.WebSvc", "evidence": ["api/payments.py:2"] },
    { "name": "SendGrid", "type": "SE.EI.TMCore.WebSvc", "evidence": ["worker/receipts.py:7"] }
  ],
  "flows": [
    { "name": "Browser interactions", "from": "Customer", "to": "Billing SPA" },
    { "name": "Login and token requests", "from": "Billing SPA", "to": "Auth0", "type": "HTTPS", "evidence": ["web/src/api.ts:4"] },
    { "name": "API requests (Bearer JWT)", "from": "Billing SPA", "to": "Gateway", "type": "HTTPS", "props": { "JSON": "Yes" }, "evidence": ["web/src/api.ts:5"] },
    { "name": "API responses", "from": "Gateway", "to": "Billing SPA", "type": "HTTPS", "props": { "JSON": "Yes" }, "evidence": ["web/src/api.ts:5"] },
    { "name": "Proxied API requests", "from": "Gateway", "to": "Billing API", "type": "HTTP", "evidence": ["docker-compose.yml:3"] },
    { "name": "Proxied API responses", "from": "Billing API", "to": "Gateway", "type": "HTTP" },
    { "name": "Payment webhooks", "from": "Stripe", "to": "Gateway", "type": "HTTPS", "props": { "authenticatesSource": "Yes", "JSON": "Yes" }, "evidence": ["api/app.py:26", "api/payments.py:8"] },
    { "name": "JWKS fetch", "from": "Auth0", "to": "Billing API", "type": "HTTPS", "evidence": ["api/auth.py:4"] },
    { "name": "Invoice queries", "from": "Billing API", "to": "Invoices DB", "evidence": ["api/db.py:2", "api/db.py:5", "api/db.py:8", "api/db.py:11"] },
    { "name": "Invoice rows", "from": "Invoices DB", "to": "Billing API", "evidence": ["api/db.py:5"] },
    { "name": "Audit events", "from": "Billing API", "to": "Audit log", "evidence": ["api/audit.py:3"] },
    { "name": "Receipt jobs", "from": "Billing API", "to": "Job queue", "evidence": ["api/app.py:23"] },
    { "name": "Receipt jobs pulled", "from": "Job queue", "to": "Receipt worker", "evidence": ["worker/receipts.py:5"] },
    { "name": "Invoice data", "from": "Invoices DB", "to": "Receipt worker", "evidence": ["worker/receipts.py:6"] },
    { "name": "Payment intents", "from": "Billing API", "to": "Stripe", "type": "HTTPS", "evidence": ["api/payments.py:5"] },
    { "name": "Receipt emails", "from": "Receipt worker", "to": "SendGrid", "props": { "providesConfidentiality": "Yes", "providesIntegrity": "Yes" }, "evidence": ["worker/receipts.py:7", "worker/receipts.py:8"] }
  ]
}
